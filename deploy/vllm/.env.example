# Copy to deploy/vllm/.env on the 4090 PC
VLLM_API_KEY=change-me-long-random-string
# Start small (7B AWQ, about 5-6 GB) to learn and benchmark; move to a Qwen3.x AWQ/FP8 build later
VLLM_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
VLLM_MAX_MODEL_LEN=16384
VLLM_GPU_UTIL=0.90
# Qwen2.5 uses Hermes-style tool calls; check docs/features/tool_calling.md in the vLLM repo for other models
VLLM_TOOL_PARSER=hermes
HF_TOKEN=

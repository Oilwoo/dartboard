# Copy to .env (never commit .env)

# OpenDART (https://opendart.fss.or.kr, free key)
DART_API_KEY=

# Discord bot: alerts and [승인]/[거절] buttons
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
DISCORD_APPROVER_USER_ID=

# LLM fallback chain, in order
LLM_ORDER=local,groq,gemini
# 1) vLLM on the 4090 PC over Tailscale (deploy/vllm)
LOCAL_LLM_URL=http://<pc-tailscale-ip>:8000/v1
LOCAL_LLM_KEY=<same as VLLM_API_KEY>
LOCAL_LLM_MODEL=local
# 2) Groq free tier (model id: console.groq.com -> Models)
GROQ_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL=
# 3) Gemini free tier, OpenAI-compatible endpoint (model id: AI Studio)
GEMINI_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=
GEMINI_MODEL=
